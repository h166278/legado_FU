<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Ng.DialogRoot">

    <LinearLayout style="@style/Ng.DialogHeader">

        <TextView
            style="@style/Ng.DialogTitle"
            android:text="@string/tts_engine_import_conflict_title" />

    </LinearLayout>

    <LinearLayout
        style="@style/Ng.DialogBody"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_import_conflict_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/ng_on_surface"
            android:textSize="16sp" />

    </LinearLayout>

    <LinearLayout style="@style/Ng.DialogActionBar">

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <io.legado.app.ui.widget.text.AccentStrokeTextView
            android:id="@+id/tv_import_keep_both"
            style="@style/Ng.DialogButton.Secondary"
            android:layout_height="42dp"
            android:minWidth="88dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="15sp"
            android:text="@string/tts_engine_import_keep_both" />

        <io.legado.app.ui.widget.text.AccentBgTextView
            android:id="@+id/tv_import_overwrite"
            style="@style/Ng.DialogButton.Primary"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:minWidth="88dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="15sp"
            android:text="@string/tts_engine_import_overwrite" />

    </LinearLayout>

</LinearLayout>
