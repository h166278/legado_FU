<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Ng.Label"
        android:layout_marginStart="12dp"
        android:text="@string/character_name" />

    <EditText
        android:id="@+id/edit_name"
        style="@style/Ng.OutlinedField"
        android:layout_marginTop="6dp"
        android:hint="@string/character_name"
        android:inputType="text"
        android:singleLine="true" />

    <TextView
        style="@style/Ng.Label"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:text="@string/character_aliases" />

    <EditText
        android:id="@+id/edit_aliases"
        style="@style/Ng.OutlinedField"
        android:layout_marginTop="6dp"
        android:hint="@string/character_aliases_hint"
        android:inputType="text"
        android:singleLine="true" />

    <TextView
        style="@style/Ng.Label"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:text="@string/character_gender" />

    <androidx.appcompat.widget.AppCompatSpinner
        android:id="@+id/spinner_gender"
        style="@style/Ng.Spinner"
        android:layout_marginTop="6dp" />

    <TextView
        style="@style/Ng.Label"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:text="@string/character_role" />

    <androidx.appcompat.widget.AppCompatSpinner
        android:id="@+id/spinner_role"
        style="@style/Ng.Spinner"
        android:layout_marginTop="6dp" />

    <TextView
        style="@style/Ng.Label"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:text="@string/character_intro" />

    <EditText
        android:id="@+id/edit_intro"
        style="@style/Ng.OutlinedField"
        android:layout_height="116dp"
        android:layout_marginTop="6dp"
        android:gravity="top|start"
        android:hint="@string/character_intro_hint"
        android:inputType="textMultiLine"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        tools:text="性格温和，遇事冷静。" />

</LinearLayout>
