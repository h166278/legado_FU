<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ng_bg_read_aloud_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <TextView
        style="@style/Ng.Title"
        android:layout_width="match_parent"
        android:gravity="center"
        android:text="朗读模式" />

    <LinearLayout
        style="@style/Ng.DialogSection"
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        android:padding="0dp">

        <LinearLayout
            android:id="@+id/item_multi_role"
            style="@style/Ng.SettingsItem"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Ng.SettingsTitle"
                    android:text="多人模式" />

                <TextView
                    android:id="@+id/text_multi_role_summary"
                    style="@style/Ng.SettingsSummary"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <io.legado.app.lib.theme.view.ThemeSwitch
                android:id="@+id/switch_multi_role"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item_storyboard_result"
            style="@style/Ng.SettingsItem"
            android:layout_marginTop="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:paddingStart="20dp"
            android:paddingEnd="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Ng.SettingsTitle"
                    android:text="分镜结果" />

                <TextView
                    style="@style/Ng.SettingsSummary"
                    android:layout_marginTop="4dp"
                    android:text="查看当前章节的角色分配和片段拆分" />
            </LinearLayout>

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chevron_right_20"
                app:tint="@color/ng_on_surface_variant" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/Ng.SettingsSectionLabel"
        android:layout_marginTop="18dp"
        android:text="分镜模式" />

    <LinearLayout
        android:id="@+id/layout_storyboard_mode"
        style="@style/Ng.DialogSection"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:id="@+id/group_storyboard_mode"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:divider="@drawable/ng_divider_ai_segment"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/segment_storyboard_mode_basic"
                style="@style/Ng.SettingsTitle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="基础分镜" />

            <TextView
                android:id="@+id/segment_storyboard_mode_scene"
                style="@style/Ng.SettingsTitle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="场景演绎" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_storyboard_mode_summary"
            style="@style/Ng.SettingsSummary"
            android:layout_width="match_parent"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="拆分旁白、对白和说话人" />
    </LinearLayout>
</LinearLayout>
