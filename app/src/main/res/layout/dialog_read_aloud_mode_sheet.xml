<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ng_bg_read_aloud_sheet"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <TextView
        style="@style/Ng.Title"
        android:layout_width="match_parent"
        android:gravity="center"
        android:text="朗读模式" />

    <LinearLayout
        android:id="@+id/layout_read_aloud_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipToOutline="true"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/group_read_aloud_mode"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/card_single_role"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:clipToOutline="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/icon_single_role"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="单人模式"
                    android:src="@drawable/ic_read_aloud_user_outline"
                    app:tint="@color/ng_on_surface_variant" />

                <TextView
                    android:id="@+id/title_single_role"
                    style="@style/Ng.SettingsTitle"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="单人模式" />

                <TextView
                    style="@style/Ng.SettingsSummary"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="单一音色朗读" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_multi_role"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:clickable="true"
                android:clipToOutline="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/icon_multi_role"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="多人模式"
                    android:src="@drawable/ic_read_aloud_users_outline"
                    app:tint="@color/ng_on_surface_variant" />

                <TextView
                    android:id="@+id/title_multi_role"
                    style="@style/Ng.SettingsTitle"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="多人模式" />

                <TextView
                    style="@style/Ng.SettingsSummary"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="多角色朗读" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_multi_role_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipToOutline="true"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/item_multi_role_engine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_horizontal"
            android:minHeight="70dp"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/text_multi_role_engine"
                style="@style/Ng.SettingsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textSize="14sp" />

            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/layout_multi_role_capabilities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:alignItems="center"
                app:flexDirection="row"
                app:flexWrap="wrap"
                app:justifyContent="center" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/item_auto_create_roles"
        style="@style/Ng.SettingsItem"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:clipToOutline="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="76dp"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Ng.SettingsTitle"
                android:text="@string/character_auto_create_roles" />

            <TextView
                style="@style/Ng.SettingsSummary"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:text="@string/character_auto_create_roles_summary" />
        </LinearLayout>

        <io.legado.app.lib.theme.view.ThemeSwitch
            android:id="@+id/switch_auto_create_roles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/item_auto_assign_voices"
        style="@style/Ng.SettingsItem"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:clipToOutline="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="76dp"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Ng.SettingsTitle"
                android:text="@string/character_auto_assign_voices" />

            <TextView
                style="@style/Ng.SettingsSummary"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:text="@string/character_auto_assign_voices_summary" />
        </LinearLayout>

        <io.legado.app.lib.theme.view.ThemeSwitch
            android:id="@+id/switch_auto_assign_voices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/item_auto_switch_scene_voices"
        style="@style/Ng.SettingsItem"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:clipToOutline="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="76dp"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Ng.SettingsTitle"
                android:text="@string/character_auto_switch_scene_voices" />

            <TextView
                style="@style/Ng.SettingsSummary"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:text="@string/character_auto_switch_scene_voices_summary" />
        </LinearLayout>

        <io.legado.app.lib.theme.view.ThemeSwitch
            android:id="@+id/switch_auto_switch_scene_voices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/item_storyboard_result"
        style="@style/Ng.SettingsItem"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:clipToOutline="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:minHeight="76dp"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Ng.SettingsTitle"
                android:text="分镜结果" />

            <TextView
                style="@style/Ng.SettingsSummary"
                android:layout_marginTop="4dp"
                android:text="查看当前章节的角色识别和片段拆分" />
        </LinearLayout>

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_chevron_right_20"
            app:tint="@color/ng_on_surface_variant" />
    </LinearLayout>

</LinearLayout>
