<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/ng_dialog_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/dialog_content"
        app:layout_constraintEnd_toEndOf="@id/dialog_content"
        app:layout_constraintStart_toStartOf="@id/dialog_content"
        app:layout_constraintTop_toTopOf="@id/dialog_content" />

    <LinearLayout
        android:id="@+id/dialog_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/reading_information"
            android:textSize="20sp"
            android:textStyle="bold" />

        <io.legado.app.ui.design.components.view.NgFloatingTabBar
            android:id="@+id/info_section_tabs"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/reading_information" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:id="@+id/ll_title_config"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <io.legado.app.ui.design.components.view.NgFloatingTabBar
                    android:id="@+id/title_mode_tabs"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:contentDescription="@string/title" />

                <io.legado.app.ui.widget.DetailSeekBar
                    android:id="@+id/dsb_title_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:max="20"
                    app:title="@string/title_font_size" />

                <io.legado.app.ui.widget.DetailSeekBar
                    android:id="@+id/dsb_title_top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:max="100"
                    app:title="@string/title_margin_top" />

                <io.legado.app.ui.widget.DetailSeekBar
                    android:id="@+id/dsb_title_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:max="100"
                    app:title="@string/title_margin_bottom" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_header_config"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/ll_header_enabled"
                    style="@style/Ng.ReadInfoRow"
                    android:layout_height="40dp">

                    <TextView
                        style="@style/Ng.ReadInfoRowLabel"
                        android:text="@string/show_header" />

                    <io.legado.app.lib.theme.view.ThemeSwitch
                        android:id="@+id/switch_header_enabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_footer_config"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/ll_footer_enabled"
                    style="@style/Ng.ReadInfoRow"
                    android:layout_height="40dp">

                    <TextView
                        style="@style/Ng.ReadInfoRowLabel"
                        android:text="@string/show_footer" />

                    <io.legado.app.lib.theme.view.ThemeSwitch
                        android:id="@+id/switch_footer_enabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_info_style_config"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/style_mode_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/ll_tip_color"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/Ng.ReadInfoRowLabel"
                                android:text="@string/tip_text_color" />

                            <TextView
                                android:id="@+id/tv_tip_color"
                                style="@style/Ng.ReadInfoRowValue"
                                android:textSize="13sp"
                                android:visibility="gone" />

                        </LinearLayout>

                        <io.legado.app.ui.design.components.view.NgFloatingTabBar
                            android:id="@+id/tip_color_mode_tabs"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:contentDescription="@string/tip_text_color" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_tip_divider_color"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:paddingHorizontal="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/Ng.ReadInfoRowLabel"
                                android:text="@string/tip_divider_color" />

                            <TextView
                                android:id="@+id/tv_tip_divider_color"
                                style="@style/Ng.ReadInfoRowValue"
                                android:textSize="13sp"
                                android:visibility="gone" />

                        </LinearLayout>

                        <io.legado.app.ui.design.components.view.NgFloatingTabBar
                            android:id="@+id/tip_divider_color_mode_tabs"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:contentDescription="@string/tip_divider_color" />

                    </LinearLayout>

                </LinearLayout>

                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/color_picker_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

            </LinearLayout>

        </FrameLayout>

        <LinearLayout
            android:id="@+id/ll_tip_content_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <io.legado.app.ui.design.components.view.NgFloatingTabBar
                android:id="@+id/tip_position_tabs"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:contentDescription="@string/reading_information" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_tip_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
