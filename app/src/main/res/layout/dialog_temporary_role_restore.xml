<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ng_bg_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Ng.Title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/character_deleted_manage_title"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/tv_select_all"
            style="@style/Ng.ActionText"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:text="@string/select_all"
            android:textSize="14sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_summary"
        style="@style/Ng.Summary"
        android:layout_marginTop="8dp"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_delete"
            style="@style/Ng.ActionText"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:text="@string/character_deleted_permanent_action"
            android:textColor="@color/ng_error"
            android:textSize="14sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <io.legado.app.ui.widget.text.AccentStrokeTextView
            android:id="@+id/tv_cancel"
            style="@style/Ng.SmallButton.Secondary"
            android:text="@string/cancel" />

        <io.legado.app.ui.widget.text.AccentBgTextView
            android:id="@+id/tv_confirm"
            style="@style/Ng.SmallButton.Primary"
            android:layout_marginStart="8dp"
            android:text="@string/character_restore_action" />

    </LinearLayout>

</LinearLayout>
