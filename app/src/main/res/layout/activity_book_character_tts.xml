<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.book.character.BookCharacterTtsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <io.legado.app.ui.widget.TitleBar
            android:id="@+id/title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/book_characters" />

        <LinearLayout
            android:id="@+id/layout_route_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ng_page_padding"
            android:layout_marginTop="@dimen/ng_space_s"
            android:layout_marginEnd="@dimen/ng_page_padding"
            android:background="@drawable/ng_bg_tag_warning"
            android:orientation="vertical"
            android:paddingStart="@dimen/ng_space_l"
            android:paddingTop="@dimen/ng_space_m"
            android:paddingEnd="@dimen/ng_space_l"
            android:paddingBottom="@dimen/ng_space_m"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_route_warning"
                style="@style/Ng.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textColor="@color/ng_warning"
                android:textSize="15sp"
                tools:text="角色引擎不可用，已临时使用默认声音兜底" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="@dimen/ng_page_padding"
            android:paddingTop="@dimen/ng_space_l"
            android:paddingEnd="@dimen/ng_page_padding"
            android:paddingBottom="@dimen/ng_space_l"
            tools:listitem="@layout/item_book_character_tts" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginStart="@dimen/ng_page_padding"
            android:layout_marginEnd="@dimen/ng_page_padding"
            android:layout_marginBottom="@dimen/ng_space_m"
            android:background="@drawable/ng_bg_character_tabs"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tv_tab_formal"
                style="@style/Ng.Summary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/ng_bg_character_tab_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/ng_character_tab_text"
                android:textSize="14sp"
                tools:text="正式角色\n4" />

            <TextView
                android:id="@+id/tv_tab_temporary"
                style="@style/Ng.Summary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/ng_bg_character_tab_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/ng_character_tab_text"
                android:textSize="14sp"
                tools:text="临时角色\n8" />

            <TextView
                android:id="@+id/tv_tab_defaults"
                style="@style/Ng.Summary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/ng_bg_character_tab_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/ng_character_tab_text"
                android:textSize="14sp"
                tools:text="默认声音\n3" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tv_empty"
        style="@style/Ng.Summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="@dimen/ng_page_padding"
        android:textSize="15sp"
        android:visibility="gone" />

</FrameLayout>
